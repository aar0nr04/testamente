{
  "name": "testamente-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude tests/firebase-rules.test.ts --exclude tests/e2e/**",
    "validate:instruments": "vitest run src/engine/instrumentEngine.test.ts src/data/instruments/registry.test.ts",
    "validate:translations": "vitest run src/data/instruments/registry.test.ts",
    "test:rules": "firebase emulators:exec --project demo-testamente --only auth,firestore,storage \"vitest run tests/firebase-rules.test.ts\"",
    "test:e2e": "playwright test",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "firebase": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.62.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^14.27.0",
    "globals": "^17.7.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
